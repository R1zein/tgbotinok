# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# ID администраторов бота через запятую (доступ к /admin)
ADMIN_IDS=123456789
# Путь к базе SQLite
DB_PATH=data/bot.db

# --- Юзербот (MTProto) для отслеживания подарков и юзернеймов ---
# Получить на https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Строка сессии: python -m bot.services.login
USERBOT_SESSION=
# Минимальная пауза между запросами юзербота (сек)
USERBOT_MIN_DELAY=1.0

# Интервал опроса новых улучшений подарков (сек)
GIFT_POLL_INTERVAL=30
# Пауза между проверками юзернеймов (сек) и интервал полного круга (сек)
USERNAME_CHECK_DELAY=2
USERNAME_CYCLE_INTERVAL=60
# Максимум отслеживаемых юзернеймов на пользователя
MAX_USERNAMES=10
# Сколько дней хранить кэш бизнес-сообщений
BUSINESS_CACHE_DAYS=14
