# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# ID администраторов бота через запятую (доступ к /admin)
ADMIN_IDS=123456789
# Путь к базе SQLite
DB_PATH=data/bot.db

# Прокси, если Telegram с сервера недоступен/тормозит (пусто — без прокси)
# Примеры: socks5://user:pass@1.2.3.4:1080   http://1.2.3.4:3128
PROXY=

# --- ИИ-ответы в группах (DeepSeek) ---
# Ключ с platform.deepseek.com (пусто — функция выключена)
DEEPSEEK_API_KEY=
# Модель и адрес API (по умолчанию самая дешёвая модель DeepSeek)
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
# Сколько ИИ-ответов бот может дать за сутки на всех (защита баланса)
AI_DAILY_LIMIT=2000
# Сколько секунд ждать ответа ИИ (под нагрузкой DeepSeek отвечает дольше)
AI_TIMEOUT=120

# --- Юзербот (MTProto) для отслеживания подарков и юзернеймов ---
# Получить на https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Строка сессии: python -m bot.services.login
USERBOT_SESSION=
# Минимальная пауза между запросами юзербота (сек)
USERBOT_MIN_DELAY=1.0

# Интервал опроса новых улучшений подарков (сек)
GIFT_POLL_INTERVAL=30
# Пауза между проверками юзернеймов (сек) и интервал полного круга (сек)
USERNAME_CHECK_DELAY=2
USERNAME_CYCLE_INTERVAL=60
# Максимум отслеживаемых юзернеймов на пользователя
MAX_USERNAMES=10
# Сколько дней хранить кэш бизнес-сообщений
BUSINESS_CACHE_DAYS=14
